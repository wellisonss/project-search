# ============================================================
# FRONTEND (Next.js) — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
#
# Obs.: variáveis com prefixo NEXT_PUBLIC_ são embutidas no bundle
# durante o build e ficam visíveis no navegador. Não coloque segredos aqui.
# ============================================================

# URL base da API de busca (backend NestJS), incluindo o prefixo /products.
#   - Backend local:              http://localhost:3336/products
#   - Backend via docker-compose: http://localhost:3336/products (acessado pelo navegador)
NEXT_PUBLIC_API_URL=http://localhost:3336/products
