# ============================================================
# Variáveis usadas pelo docker-compose.yml (raiz)
# Copie para ".env" e ajuste.
# ============================================================

# Ambiente do Meilisearch: development | production
MEILI_ENV=development

# Chave mestra do Meilisearch (>= 16 caracteres em produção)
MEILI_MASTER_KEY=masterKey

# Chave da API do Google Gemini (opcional — habilita a busca semântica).
# Deixe vazio para rodar apenas com busca textual.
GEMINI_API_KEY=

# Povoamento a partir da prjdev-competitividade-api (POST /products/povoar-por-lista)
# — este serviço chama GET {API_PRINCIPAL_URL}/busca-produtos/produtos-por-lista.
API_PRINCIPAL_URL=http://host.docker.internal:3000
# mesmo valor configurado na prjdev-competitividade-api (PROJECT_SEARCH_SECRET lá)
PROJECT_SEARCH_SECRET=
# M_PriceList_Version_ID das listas a povoar por padrão (sem body explícito)
PROJECT_SEARCH_PRICE_LIST_IDS=5000088,5000089

# Portas expostas no host
API_PORT=3336
WEB_PORT=3000

# URL da API consumida pelo navegador (embutida no build do frontend)
NEXT_PUBLIC_API_URL=http://localhost:3336/products
