# ============================================================
# BACKEND (NestJS) — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# ============================================================

# --- API ---
# Porta em que a API NestJS vai rodar
PORT=3336

# --- Meilisearch (motor de busca) ---
# Endereço do Meilisearch.
#   - Rodando localmente:        http://localhost:7700
#   - Rodando via docker-compose: http://meilisearch:7700
MEILISEARCH_HOST=http://localhost:7700

# Chave mestra do Meilisearch (deve ter no mínimo 16 caracteres em produção)
MEILISEARCH_KEY=masterKey

# --- Busca semântica com IA (opcional) ---
# Chave da API do Google Gemini, usada para gerar embeddings e habilitar a
# busca híbrida (semântica + textual). Se estiver vazia, mantenha a busca com
# IA desativada no painel de Configurações.
# Gere em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
